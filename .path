#!/bin/bash

# Google Cloud SDK — only source if the dir actually exists. Old installs
# went under ~/tools/google-cloud-sdk; on macOS, Homebrew puts the SDK
# under /opt/homebrew/share/google-cloud-sdk.
for gcloud_root in "$HOME/tools/google-cloud-sdk" "/opt/homebrew/share/google-cloud-sdk"; do
  if [ -d "$gcloud_root" ]; then
    # shellcheck source=/dev/null
    [ -f "$gcloud_root/path.bash.inc" ] && . "$gcloud_root/path.bash.inc"
    # shellcheck source=/dev/null
    [ -f "$gcloud_root/completion.bash.inc" ] && . "$gcloud_root/completion.bash.inc"
    break
  fi
done
unset gcloud_root

# PATH additions — only append entries whose directory exists.
_path_append() {
  if [ -d "$1" ]; then
    case ":$PATH:" in
      *":$1:"*) ;;
      *) export PATH="$PATH:$1" ;;
    esac
  fi
}
_path_prepend() {
  if [ -d "$1" ]; then
    case ":$PATH:" in
      *":$1:"*) ;;
      *) export PATH="$1:$PATH" ;;
    esac
  fi
}

_path_prepend "/usr/local/bin"
_path_append "/usr/local/go/bin"
[ -n "${GOPATH:-}" ] && _path_append "$GOPATH/bin"
_path_append "/usr/share/bcc/tools"
_path_append "/sbin"
_path_append "$HOME/tools/google-cloud-sdk/bin"
_path_append "$HOME/tools/node/bin"
_path_append "$HOME/tools/flyway"

unset -f _path_append _path_prepend
