#!/bin/bash

if is_osx; then
  # macOS specific aliases
  alias gpg2='gpg'
else
  # Debian / Linux specific aliases
  alias open='xdg-open'
  alias pbcopy='xclip -selection clipboard'
  alias pbpaste='xclip -selection clipboard -o'
fi

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"

# Stopwatch
alias timer='echo "Timer started. Stop with Ctrl-D." && date && time cat && date'

# IP addresses
alias pubip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="sudo ifconfig | grep -Eo 'inet (addr:)?([0-9]*\\.){3}[0-9]*' | grep -Eo '([0-9]*\\.){3}[0-9]*' | grep -v '127.0.0.1'"
alias ips="sudo ifconfig -a | grep -o 'inet6\\? \\(addr:\\)\\?\\s\\?\\(\\(\\([0-9]\\+\\.\\)\\{3\\}[0-9]\\+\\)\\|[a-fA-F0-9:]\\+\\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Flush Directory Service cache
alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"

# View HTTP traffic — pass interface as $1, default to whatever ngrep/tcpdump auto-pick
sniff() { sudo ngrep -d "${1:-any}" -t '^(GET|POST) ' 'tcp and port 80'; }
httpdump() { sudo tcpdump ${1:+-i "$1"} -n -s 0 -w - | grep -a -o -E "Host\\: .*|GET \\/.*"; }

# One of @janmoesen's ProTip™s — lwp-request wrappers (perl libwww). Disabled
# because lwp-request is rarely installed; uncomment if needed.
# for method in GET HEAD POST PUT DELETE TRACE OPTIONS; do
#     # shellcheck disable=SC2139,SC2140
#     alias "$method"="lwp-request -m \"$method\""
# done

# Pipe SSH keys to clipboard (cross-platform)
if is_osx; then
  alias pubkey="more ~/.ssh/id_rsa.pub | pbcopy && echo '=> Public key copied to pasteboard.'"
  alias prikey="more ~/.ssh/id_rsa | pbcopy && echo '=> Private key copied to pasteboard.'"
else
  alias pubkey="more ~/.ssh/id_rsa.pub | xclip -selection clipboard && echo '=> Public key copied to pasteboard.'"
  alias prikey="more ~/.ssh/id_rsa | xclip -selection clipboard && echo '=> Private key copied to pasteboard.'"
fi

# git wrapper to set GPG_TTY for signing inside tmux
alias git="GPG_TTY=\$(tty); git"

# IntelliJ terminal start
alias idea="idea & disown"

# Lastpass
alias mypass="lpass show --password --clip"

# Syncthing Conflicts
alias sync-error-list="find . -type f -name \"*sync-conflict*\" "
alias sync-error-clean="find . -type f -name \"*sync-conflict*\" -print0 | xargs -0 -I {} rm -rf \"{}\""

# VS Code (insiders build)
alias code="code-insiders"

# Terraform
alias tfi="terraform init"
alias tff="terraform fmt --recursive"
alias tfp="terraform plan"
alias tfa="terraform apply"

# Per-machine aliases and secrets (gitignored)
# shellcheck source=/dev/null
[ -f "$HOME/.aliases.local" ] && . "$HOME/.aliases.local"
